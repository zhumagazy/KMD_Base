# Скопируйте в переменные окружения хостинга
DEBUG=false
SECRET_KEY=замените-на-длинную-случайную-строку
ALLOWED_HOSTS=kb.kazmeddez.kz
CSRF_TRUSTED_ORIGINS=https://kb.kazmeddez.kz
DATABASE_URL=postgres://user:password@host:5432/kmd_base
# Первый администратор создаётся автоматически при деплое
ADMIN_USERNAME=admin
ADMIN_PASSWORD=смените-пароль
ADMIN_EMAIL=
# Где хранить загруженные файлы (смонтируйте постоянный диск)
MEDIA_ROOT=/var/data/media
TIME_ZONE=Asia/Almaty
